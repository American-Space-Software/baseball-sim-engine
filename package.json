{
  "name": "baseball-sim-engine",
  "version": "2.1.2",
  "description": "A deterministic baseball simulation engine written in TypeScript. The engine runs in both Node.js and browser environments.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js"
    },
    "./ratings": {
      "types": "./dist/ratings.d.ts",
      "import": "./dist/ratings.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    }    
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
      "test": "node --env-file=.env --loader ts-node/esm ./node_modules/mocha/bin/mocha --timeout 9999999999 \"test/**/*.spec.ts\"",
      "test1": "node --env-file=.env --loader ts-node/esm ./node_modules/mocha/bin/mocha --timeout 9999999999 test/mlb-roster-service.spec.ts",

      "build:js": "node --loader ts-node/esm ./node_modules/webpack/bin/webpack.js --config=webpack.ts",
      "build:types": "tsc --project tsconfig.types.json",
      "build": "npm run build:js && npm run build:types",
      "build:dev": "node --loader ts-node/esm ./node_modules/webpack/bin/webpack.js --config=webpack.ts --watch",

      "download": "node --env-file=.env ./dist/ratings.js download",
      "download:all": "node --env-file=.env ./dist/ratings.js download all",
      "generate:ratings": "node --env-file=.env ./dist/ratings.js generate ratings",

      "generate:env": "node --env-file=.env ./dist/importer.js",

      "rebuild:all": "node --env-file=.env --input-type=module -e \"const { downloadService } = await import('./dist/ratings.js'); downloadService.rebuildAllGames()\"",

      "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/American-Space-Software/baseball-sim-engine.git"
  },
  "bugs": {
    "url": "https://github.com/American-Space-Software/baseball-sim-engine/issues"
  },
  "homepage": "https://github.com/American-Space-Software/baseball-sim-engine#readme",
  "keywords": [
    "baseball",
    "simulation",
    "sim",
    "typescript",
    "javascript",
    "esm"
  ],
  "author": "Patrick Toner",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.8.2",
    "mocha": "11.7.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "seedrandom": "3.0.5",
    "mlb-stats-api": "2.0.0",
    "uuid": "9.0.1",
    "openai": "6.37.0",
    "framework7-loader": "3.0.2",
    "framework7": "9.1.2"
  },
  "dependencies": {
    "baseball-database": "1.2.6",
    "better-sqlite3": "13.0.2",
    "glicko2": "1.2.2"
  }
}